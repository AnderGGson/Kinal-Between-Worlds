function scrGenTemplates() {
	var f = file_text_open_read("templates/rooms.json");
	if (f < 0) {
		f = file_text_open_read("datafiles/templates/rooms.json");
	}

	if (f >= 0) {
		var json = file_text_read_string(f);
		file_text_close(f);

		var data = json_decode(json);

		if (data != undefined && is_array(data) && array_length(data) > 0) {
			return data;
		}
	}

	show_debug_message("scrGenTemplates: usando fallback");
	return scrGenTemplatesFallback();
}
